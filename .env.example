# Copy to .env and fill in. docker compose reads this file automatically.

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local testing without Google: "sign in as any email" (never works in production) ---
DEV_LOGIN_ENABLED=true

# --- Claude (recommendations + RAG answers) ---
# anthropic = Claude API key | bedrock = Claude in Amazon Bedrock (IAM) | aws = Claude Platform on AWS | none
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5            # bedrock default: anthropic.claude-opus-5-5
# ANTHROPIC_AWS_WORKSPACE_ID=           # required for LLM_PROVIDER=aws

# --- AWS (used by bedrock / ses / titan embeddings) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Embeddings for RAG + recommendations ---
# local = MiniLM running inside the container (no key) | bedrock = Amazon Titan Text Embeddings v2
EMBEDDING_PROVIDER=local

# --- Email for invites ---
# smtp = Mailpit in docker compose | ses = Amazon SES | console = log the link
# MAIL_PROVIDER=smtp
# MAIL_FROM="Bookclub <invites@yourdomain.com>"

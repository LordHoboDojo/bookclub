{
  "name": "bookclub",
  "version": "1.0.0",
  "private": true,
  "description": "Book club web app: Google sign-in, leader invites, AI recommendations and RAG over club discussions.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "reindex": "node --env-file-if-exists=.env scripts/reindex.js",
    "test": "node --test \"test/**/*.test.js\"",
    "eval:rag": "node --env-file-if-exists=.env scripts/eval-retrieval.js"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^1.1.1",
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1159.0",
    "@aws-sdk/client-sesv2": "^3.1159.0",
    "@huggingface/transformers": "^4.3.2",
    "connect-mongo": "^6.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}

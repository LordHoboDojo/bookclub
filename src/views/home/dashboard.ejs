<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Welcome back</p>
    <h1><%= h.displayName(currentUser) %>'s clubs</h1>
  </div>
  <a class="btn btn-primary" href="/clubs/new">Start a club</a>
</div>

<% if (invites.length) { %>
  <section class="section">
    <h2 class="section-title">Invitations</h2>
    <div class="invite-list">
      <% invites.forEach(function (inv) { %>
        <div class="card invite-card">
          <div>
            <strong><%= inv.club.name %></strong>
            <p class="muted small"><%= h.displayName(inv.invitedBy) %> invited you · expires <%= h.formatDate(inv.expiresAt) %></p>
          </div>
          <p class="muted small">Use the link in your invite email to accept.</p>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (!clubs.length) { %>
  <section class="empty card">
    <h2>No clubs yet</h2>
    <p class="muted">Start a club and invite your friends, or accept an invite from a club leader.</p>
    <div class="row-actions">
      <a class="btn btn-primary" href="/clubs/new">Start a club</a>
      <% if (devLoginEnabled) { %>
        <form method="post" action="/dev/demo-club">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn" type="submit" data-loading="Setting up…">Load a demo club</button>
        </form>
      <% } %>
    </div>
  </section>
<% } else { %>
  <section class="club-grid">
    <% clubs.forEach(function (club) {
         const reading = club.books.find(function (b) { return b.status === 'reading' && b.book; });
         const leader = String(club.leader) === String(currentUser._id); %>
      <a class="card club-card" href="/clubs/<%= club._id %>">
        <div class="club-card-cover">
          <% if (reading) { %><%- include('../partials/cover', { book: reading.book, size: 'sm' }) %><% } else { %><div class="cover cover-sm cover-empty"></div><% } %>
        </div>
        <div class="club-card-body">
          <h3><%= club.name %> <% if (leader) { %><span class="badge">Leader</span><% } %></h3>
          <p class="muted small"><%= h.plural(club.members.length, 'member') %> · <%= h.plural(club.books.length, 'book') %></p>
          <p class="small"><%= reading ? `Reading ${reading.book.title}` : 'Nothing on the go yet' %></p>
        </div>
      </a>
    <% }) %>
  </section>
  <% if (devLoginEnabled && !clubs.some(function (c) { return c.name === 'The Lamplight Readers'; })) { %>
    <form method="post" action="/dev/demo-club" class="demo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-link" type="submit" data-loading="Setting up…">+ Load a demo club with reviews and notes</button>
    </form>
  <% } %>
<% } %>
<%- include('../partials/foot') %>

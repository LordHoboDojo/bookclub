# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
aws_region           = "us-east-1"
google_client_id     = "1234567890-abc.apps.googleusercontent.com"
google_client_secret = "GOCSPX-..."
ses_from_email       = "invites@yourdomain.com"

# Claude: "bedrock" uses the ECS task role (no keys). Use "anthropic" + anthropic_api_key for the Claude API.
llm_provider       = "bedrock"
embedding_provider = "bedrock"
